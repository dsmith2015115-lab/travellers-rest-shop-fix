<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RestfulTweaksShopRefreshFix</AssemblyName>
    <RootNamespace>TravellersRest.ShopRefreshFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/RestfulTweaksShopRefreshFix.cs" />

    <Reference Include="BepInEx">
      <HintPath>libs\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx 5.4.x itself is built against UnityEngine 5.6.1. -->
    <PackageReference Include="UnityEngine" Version="5.6.1" IncludeAssets="compile" />
  </ItemGroup>
</Project>
